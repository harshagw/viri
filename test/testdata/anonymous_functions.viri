var add: fun(number, number): number = fun(a: number, b: number): number {
  return a + b;
};

print add(5, 10);

var multiply: fun(number, number): number = fun(a: number, b: number): number {
  return a * b;
};

print multiply(3, 4);

var a: number = fun (a: number, b: number): number { return a + b; }(500, 1000);

print a;

// Will not print anything but it should not give an error;
fun (): number { return 1; }();
fun (a: number, b: number): number {return a - b;}(12, 5);
fun (a: number, b: number): number {return a * b;};

// Immediately invoked function expression (IIFE)
print fun(x: number): number { return x * x; }(5);

// Function as argument
var apply: fun(fun(number): number, number): number = fun(f: fun(number): number, x: number): number {
  return f(x);
};

print apply(fun(x: number): number { return x + 1; }, 10);

// Closure with anonymous function
var makeCounter: fun(): fun(): number = fun(): fun(): number {
  var count: number = 0;
  return fun(): number {
    count = count + 1;
    return count;
  };
};

var counter: fun(): number = makeCounter();
print counter();
print counter();


var newAdder: fun(number): fun(number): number = fun(a: number): fun(number): number {
  var adder: fun(number): number = fun(b: number): number { return a + b; };
  return adder;
};

var addTwo: fun(number): number = newAdder(2);
print addTwo(3);
