// Block-scoped locals get their own frame slots
fun blockLocals() {
  {
    var a = 1;
    var b = 2;
    var c = 3;
    print a + b + c;
  }
}
blockLocals();

// A top-level block variable does not collide with later globals
var g = nil;
{
  var a = 10;
  g = fun() { return a; };
}
var after = 20;
print g();
print after;

// Closures created in a loop capture per-iteration values
var fns = [nil, nil, nil];
for (var i = 0; i < 3; i = i + 1) {
  var j = i;
  fns[i] = fun() { return j; };
}
print fns[0]();
print fns[1]();
print fns[2]();

// Captured variables appear as plain values in arrays and hashes
fun captured() {
  var x = 1;
  fun set() { x = 2; }
  set();
  print [x];
  print {"k": x};
  var k = "key";
  fun rename() { k = "keyB"; }
  rename();
  print {k: 1};
}
captured();

// Arguments are passed by value, even when the caller passes a captured variable
fun outer() {
  var x = 1;
  fun mid() {
    fun take(y) {
      fun set() { y = 99; }
      set();
      return y;
    }
    print take(x);
    print x;
  }
  mid();
}
outer();
