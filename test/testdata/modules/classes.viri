// Module with exported class
export class Counter {
    value: number;
    init(start: number) {
        this.value = start;
    }

    increment() {
        this.value = this.value + 1;
    }

    getValue(): number {
        return this.value;
    }
}

export class Point {
    x: number;
    y: number;
    init(x: number, y: number) {
        this.x = x;
        this.y = y;
    }
}
