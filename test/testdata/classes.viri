// Basic Class Definition and Instantiation

class Point {
  x: number;
  y: number;
  init(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
}

var p: Point = Point(3, 4);
print p.x;
print p.y;

// Class with Methods

class Counter {
  count: number;
  init() {
    this.count = 0;
  }

  increment() {
    this.count = this.count + 1;
  }

  decrement() {
    this.count = this.count - 1;
  }

  getCount(): number {
    return this.count;
  }
}

var counter: Counter = Counter();
print counter.getCount();
counter.increment();
counter.increment();
counter.increment();
print counter.getCount();
counter.decrement();
print counter.getCount();

// Class with Method Returning Value

class Calculator {
  value: number;
  init(value: number) {
    this.value = value;
  }

  add(n: number): Calculator {
    this.value = this.value + n;
    return this;
  }

  multiply(n: number): Calculator {
    this.value = this.value * n;
    return this;
  }

  getValue(): number {
    return this.value;
  }
}

var calc: Calculator = Calculator(10);
calc.add(5);
calc.multiply(2);
print calc.getValue();

// Method Chaining

var calc2: Calculator = Calculator(1);
print calc2.add(2).multiply(3).add(4).getValue();

// Class with Multiple Instances

class Dog {
  name: string;
  breed: string;
  init(name: string, breed: string) {
    this.name = name;
    this.breed = breed;
  }

  bark(): string {
    return this.name + " says woof!";
  }
}

var dog1: Dog = Dog("Rex", "German Shepherd");
var dog2: Dog = Dog("Buddy", "Golden Retriever");
print dog1.bark();
print dog2.bark();
print dog1.name;
print dog2.breed;

// Class without init

class Empty {
  getValue(): number {
    return 42;
  }
}

var e: Empty = Empty();
print e.getValue();

// Every declared field must hold a value once init returns, so a field the
// caller will overwrite still starts from something

class Box {
  items: number;
  label: string;
  init() {
    this.items = 0;
    this.label = "";
  }

  getLabel(): string {
    return this.label;
  }
}

var box: Box = Box();
box.label = "Fragile";
print box.label;
box.items = 5;
print box.items;
print box.getLabel();
