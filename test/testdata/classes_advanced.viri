// Helper class for composition tests
class Point {
  x: number;
  y: number;
  init(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
}

// Class with closure in method

class Adder {
  base: number;
  init(base: number) {
    this.base = base;
  }

  makeAdder(): fun(number): number {
    var base: number = this.base;
    fun adder(n: number): number {
      return base + n;
    }
    return adder;
  }
}

var adder: Adder = Adder(10);
var addTen: fun(number): number = adder.makeAdder();
print addTen(5);
print addTen(20);

// Passing class instance to function

fun printPoint(point: Point) {
  print point.x;
  print point.y;
}

var pt: Point = Point(100, 200);
printPoint(pt);

// Storing class instance in array

var points: []Point = [Point(1, 2), Point(3, 4), Point(5, 6)];
print points[0].x;
print points[1].y;
print points[2].x;

// Storing class instance in hash

var shapes: map[string]Point = {"origin": Point(0, 0), "corner": Point(10, 10)};
print shapes["origin"].x;
print shapes["corner"].y;

// Method with multiple parameters

class Rectangle {
  width: number;
  height: number;
  init(width: number, height: number) {
    this.width = width;
    this.height = height;
  }

  resize(newWidth: number, newHeight: number) {
    this.width = newWidth;
    this.height = newHeight;
  }

  area(): number {
    return this.width * this.height;
  }

  perimeter(): number {
    return 2 * (this.width + this.height);
  }
}

var rect: Rectangle = Rectangle(5, 10);
print rect.area();
print rect.perimeter();
rect.resize(8, 12);
print rect.area();

// Class using other class instances (composition)

class Line {
  start: Point;
  end: Point;
  init(start: Point, end: Point) {
    this.start = start;
    this.end = end;
  }

  midpoint(): Point {
    var mx: number = (this.start.x + this.end.x) / 2;
    var my: number = (this.start.y + this.end.y) / 2;
    return Point(mx, my);
  }
}

var line: Line = Line(Point(0, 0), Point(10, 10));
var mid: Point = line.midpoint();
print mid.x;
print mid.y;

// Method returning this for builder pattern

class StringBuilder {
  str: string;
  init() {
    this.str = "";
  }

  append(s: string): StringBuilder {
    this.str = this.str + s;
    return this;
  }

  build(): string {
    return this.str;
  }
}

var sb: StringBuilder = StringBuilder();
print sb.append("Hello").append(" ").append("World").build();

// Class with conditional logic in methods

class NumberChecker {
  n: number;
  init(n: number) {
    this.n = n;
  }

  isPositive(): bool {
    return this.n > 0;
  }

  isGreaterThanTen(): bool {
    return this.n > 10;
  }

  classify(): string {
    if (this.isPositive()) {
      if (this.isGreaterThanTen()) {
        return "positive large";
      } else {
        return "positive small";
      }
    } else {
      return "non-positive";
    }
  }
}

var checker1: NumberChecker = NumberChecker(4);
var checker2: NumberChecker = NumberChecker(20);
var checker3: NumberChecker = NumberChecker(-2);
print checker1.classify();
print checker2.classify();
print checker3.classify();

// Class with loop in method

class Summer {
  sumTo(n: number): number {
    var total: number = 0;
    for (var i: number = 1; i <= n; i = i + 1) {
      total = total + i;
    }
    return total;
  }
}

var summer: Summer = Summer();
print summer.sumTo(10);
