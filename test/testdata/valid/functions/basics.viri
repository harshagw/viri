fun add(a: number, b: number): number {
	return a + b;
}
print add(5, 7);

fun factorial(n: number): number {
	if (n <= 1) return 1;
	return n * factorial(n - 1);
}
print factorial(5);

fun counter(): fun(): number {
	var count: number = 0;
	fun increment(): number {
		count = count + 1;
		return count;
	}
	return increment;
}
var c: fun(): number = counter();
print c();
print c();
