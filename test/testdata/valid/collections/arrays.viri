var nums: []number = [1, 2, 3];
print nums[0];
print nums[2];
print len(nums);

nums[1] = 20;
print nums[1];

var empty: []string = [];
print len(empty);

var flags: []bool = [true, false, true];
print flags[1];

var grid: [][]number = [[1, 2], [3, 4]];
print grid[1][0];
print len(grid);

var words: []string = ["a", "b"];
print words[0] + words[1];

fun sum(xs: []number): number {
  var total: number = 0;
  for (var i: number = 0; i < len(xs); i = i + 1) {
    total = total + xs[i];
  }
  return total;
}
print sum(nums);

fun fill(buf: []number, n: number): []number {
  for (var i: number = 0; i < len(buf); i = i + 1) {
    buf[i] = n;
  }
  return buf;
}
var filled: []number = fill([0, 0, 0], 7);
print filled[0] + filled[2];

var last: number = nums[len(nums) - 1];
print last;
