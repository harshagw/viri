// Inheritance - Basic

class Animal {
  name: string;
  init(name: string) {
    this.name = name;
  }

  speak(): string {
    return this.name + " makes a sound";
  }
}

class Cat < Animal {
  color: string;
  init(name: string, color: string) {
    super.init(name);
    this.color = color;
  }

  speak(): string {
    return this.name + " says meow!";
  }
}

var animal: Animal = Animal("Generic");
var cat: Cat = Cat("Whiskers", "orange");
print animal.speak();
print cat.speak();
print cat.color;

// Inheritance - Calling parent methods via super

class Vehicle {
  brand: string;
  init(brand: string) {
    this.brand = brand;
  }

  describe(): string {
    return "Brand: " + this.brand;
  }
}

class Car < Vehicle {
  model: string;
  init(brand: string, model: string) {
    super.init(brand);
    this.model = model;
  }

  describe(): string {
    return super.describe() + ", Model: " + this.model;
  }
}

var car: Car = Car("Toyota", "Camry");
print car.describe();

// Inherited method access

class Shape {
  name: string;
  init(name: string) {
    this.name = name;
  }

  getName(): string {
    return this.name;
  }
}

class Circle < Shape {
  radius: number;
  init(radius: number) {
    super.init("Circle");
    this.radius = radius;
  }

  getArea(): number {
    return 3.14159 * this.radius * this.radius;
  }
}

var circle: Circle = Circle(5);
print circle.getName();
print circle.getArea();

// Overriding and extending parent behavior

class Logger {
  log(msg: string): string {
    return "[LOG] " + msg;
  }
}

class TimestampLogger < Logger {
  log(msg: string): string {
    return "[2024] " + super.log(msg);
  }
}

var logger: TimestampLogger = TimestampLogger();
print logger.log("Hello");
