// Top-level functions can reference globals declared later in the file
fun isEven(n) {
  if (n == 0) { return true; }
  return isOdd(n - 1);
}
fun isOdd(n) {
  if (n == 0) { return false; }
  return isEven(n - 1);
}
print isEven(10);
print isOdd(7);

fun callsLater() { return declaredLater * 2; }
var declaredLater = 21;
print callsLater();
